# Token du bot : https://discord.com/developers/applications > ton appli > Bot > Reset Token
DISCORD_TOKEN=
# Optionnel : ID de ton serveur, pour que les slash commands apparaissent tout de suite
GUILD_ID=

MESSAGES=false
REPONSES_TEXTE=no yes

# Ambiance : attente entre deux bruits, en minutes
INTERVALLE_MIN=5
INTERVALLE_MAX=10
# Ecoute : Ben repond quand quelqu'un dit ce mot dans le vocal
ECOUTE=true
MOT_CLE=ben
# Temps mort en secondes apres une reponse, pour qu'il ne s'emballe pas
DELAI_ECOUTE=1.5
# Il ne reagit que si Vosk est sur de lui a ce niveau (0 a 1)
SEUIL_ECOUTE=0.9
# Mots proches ajoutes au vocabulaire pour absorber les confusions.
# Sans eux, "bonjour" declenche Ben. N'y mets pas de rimes trop proches
# (benne, bain) : elles voleraient les vraies detections.
LEURRES=bonjour bonsoir bon bonne bien beau banc blanc banane bonbon
